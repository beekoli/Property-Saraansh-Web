From 81fe58baa493a313897e4b8d485d79c5d2054adb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 15 Aug 2026 20:07:56 +0000
Subject: [PATCH] fix(home): stop cropping the founder photo in a landscape
 frame
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The photo is 1400x1875 — portrait, aspect 0.747. The frame was
aspect-[3/2], landscape at 1.5, with object-cover. That threw away
roughly half the image height and cut Saraansh off at the waist, leaving
a large expanse of blank wall as the most prominent thing in the section.

The frame is now aspect-[3/4] (0.75), which matches the source almost
exactly, so nothing is cropped. object-top keeps the face safe if the
frame is ever changed again.

Also switches the raw <img> to next/image. It is a large above-the-fold
asset on the homepage, so it now gets responsive sizing and modern
formats instead of shipping the full 200KB file to every device, and the
alt text names him as the founder rather than reading 'Saraansh Seth'
alone. This clears the last no-img-element warning on the page.
---
 src/app/page.tsx | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/src/app/page.tsx b/src/app/page.tsx
index e101523..c462c56 100644
--- a/src/app/page.tsx
+++ b/src/app/page.tsx
@@ -1,4 +1,5 @@
 import Link from 'next/link';
+import Image from 'next/image';
 import PropertyCard from '@/components/PropertyCard';
 import VideoPlayer from '@/components/VideoPlayer';
 import BlogCard from '@/components/BlogCard';
@@ -298,12 +299,19 @@ export default async function Home() {
         <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
           <StaggerContainer className="flex flex-col md:flex-row items-center gap-16" staggerChildren={0.2}>
             <StaggerItem className="w-full md:w-5/12" yOffset={30}>
-              <div className="relative aspect-[3/2] rounded-2xl overflow-hidden border-4 border-brand-accent/30 shadow-2xl bg-brand-pale/10">
-                <img 
-                  src="/saraansh_seth.webp" 
-                  alt="Saraansh Seth" 
-                  className="w-full h-full object-cover" 
-                  loading="lazy"
+              {/* The photo is 1400x1875 — portrait. The frame was aspect-[3/2],
+                  landscape, so object-cover threw away roughly half the image
+                  height and cut Saraansh off at the waist. 3/4 matches the
+                  source almost exactly (0.75 against 0.747), so nothing is
+                  cropped; object-top keeps the face safe if the frame ever
+                  changes again. */}
+              <div className="relative aspect-[3/4] rounded-2xl overflow-hidden border-4 border-brand-accent/30 shadow-2xl bg-brand-pale/10">
+                <Image
+                  src="/saraansh_seth.webp"
+                  alt="Saraansh Seth, founder of Property Saraansh"
+                  fill
+                  sizes="(max-width: 768px) 100vw, 42vw"
+                  className="object-cover object-top"
                 />
               </div>
             </StaggerItem>
-- 
