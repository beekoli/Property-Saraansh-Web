diff --git a/scripts/verify-video-slug.ts b/scripts/verify-video-slug.ts
new file mode 100644
index 0000000..1476707
--- /dev/null
+++ b/scripts/verify-video-slug.ts
@@ -0,0 +1,63 @@
+/**
+ * Guards the fallback slug for videos that have no curated entry yet.
+ *
+ * The Reviews channel publishes faster than anyone hand-writes entries in
+ * videos.ts, so those uploads get a generated slug: the title, slugified, with
+ * the YouTube id on the end. The id is load-bearing — it is how the watch page
+ * resolves a brand-new upload live from the API instead of 404ing.
+ *
+ * The bug this pins: truncation used to run after the trailing hyphens were
+ * trimmed, so a 60-character cut landing on a hyphen produced a doubled one
+ * before the id — ".../…-actually-worth-it--D9cK37IEPH8".
+ *
+ * Run: npx ts-node --compiler-options '{"module":"commonjs"}' scripts/verify-video-slug.ts
+ */
+import { getVideoSlug } from "../src/lib/videoSlug";
+
+let failures = 0;
+function check(name: string, actual: unknown, expected: unknown) {
+  const ok = JSON.stringify(actual) === JSON.stringify(expected);
+  if (!ok) failures++;
+  console.log(`${ok ? "ok  " : "FAIL"}  ${name}\n      → ${JSON.stringify(actual)}${ok ? "" : `\n      expected ${JSON.stringify(expected)}`}`);
+}
+function assert(name: string, condition: boolean) {
+  if (!condition) failures++;
+  console.log(`${condition ? "ok  " : "FAIL"}  ${name}`);
+}
+
+// The real title that produced the doubled hyphen.
+const cullinan = getVideoSlug({
+  id: "D9cK37IEPH8",
+  title: "M3M Cullinan Noida: Is the ₹32,000/sqft 4 BHK Actually Worth It? Honest Review",
+});
+assert("no doubled hyphen anywhere", !cullinan.includes("--"));
+assert("ends with the video id", cullinan.endsWith("-D9cK37IEPH8"));
+check("cullinan slug", cullinan, "m3m-cullinan-noida-is-the-32000sqft-4-bhk-actually-worth-it-D9cK37IEPH8");
+
+// A short title is left alone apart from the id.
+check("short title", getVideoSlug({ id: "abc12345678", title: "Godrej Arden Review" }), "godrej-arden-review-abc12345678");
+
+// Punctuation, currency symbols and repeated spaces collapse cleanly.
+check(
+  "messy punctuation",
+  getVideoSlug({ id: "xyz98765432", title: "  Sector 150: ₹1.2Cr?? Really!!  " }),
+  "sector-150-12cr-really-xyz98765432"
+);
+
+// A single very long word cannot be trimmed to nothing.
+const oneWord = getVideoSlug({ id: "long11111111".slice(0, 11), title: "a".repeat(200) });
+assert("long single word still yields a slug", oneWord.length > 20 && !oneWord.includes("--"));
+
+// No generated slug ever ends mid-hyphen before the id.
+const titles = [
+  "Noida Expressway 4 BHK Comparison: Which One Actually Wins In 2026",
+  "Is ACE Arte Worth The Price? Sector 150 Analysis And Honest Verdict",
+  "Eldeco 7 Peaks Greater Noida HONEST Review | Price, Layout Truth & Investment",
+];
+titles.forEach((t, i) => {
+  const s = getVideoSlug({ id: `id${i}0000000`.slice(0, 11), title: t });
+  assert(`no doubled hyphen: "${t.slice(0, 40)}…"`, !s.includes("--"));
+});
+
+console.log(failures === 0 ? "\nAll checks passed." : `\n${failures} check(s) failed.`);
+process.exit(failures === 0 ? 0 : 1);
diff --git a/src/lib/videoSlug.ts b/src/lib/videoSlug.ts
new file mode 100644
index 0000000..95e3523
--- /dev/null
+++ b/src/lib/videoSlug.ts
@@ -0,0 +1,39 @@
+/**
+ * The URL slug for a video that has no hand-written entry in videos.ts.
+ *
+ * Kept in its own module (no Next-specific imports) so scripts/verify-video-slug.ts
+ * can exercise it under plain ts-node.
+ */
+
+/**
+ * The fallback slug for a video with no hand-written entry in videos.ts:
+ * the title, slugified, with the YouTube id on the end so the watch page can
+ * find the video again from the URL alone.
+ *
+ * The id is not decoration — it is how /our-videos/[slug] resolves a brand-new
+ * upload live from the API instead of 404ing. A curated entry replaces this
+ * whole slug with a clean one, and resolveVideo() redirects here to there.
+ *
+ * Truncation happens before the trailing hyphens are trimmed, not after: the
+ * previous order cut "…worth-it-honest-review" at 60 characters, landing on a
+ * hyphen, and then appended "-<id>" to produce "…worth-it--D9cK37IEPH8". The
+ * cut also falls back to the last whole word so a slug never ends mid-word.
+ */
+export function getVideoSlug(video: { id: string; title: string }): string {
+  const full = video.title
+    .toLowerCase()
+    .replace(/[^\w\s-]/g, '') // Remove non-word chars
+    .replace(/[\s_-]+/g, '-') // Replace spaces and underscores with hyphens
+    .replace(/^-+|-+$/g, ''); // Trim hyphens
+
+  let slugifiedTitle = full;
+  if (full.length > 60) {
+    const cut = full.substring(0, 60);
+    // Prefer the last complete word, unless that would leave almost nothing.
+    const lastHyphen = cut.lastIndexOf('-');
+    slugifiedTitle = lastHyphen > 20 ? cut.substring(0, lastHyphen) : cut;
+  }
+  slugifiedTitle = slugifiedTitle.replace(/-+$/, '');
+
+  return `${slugifiedTitle}-${video.id}`;
+}
