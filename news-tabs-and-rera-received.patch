-  "Launch": "🚀", "Possession": "🔑", "RERA No.": "✅", "Base Price": "💰",
+  "RERA Received": "🚀", "RERA Completion": "🏁", "Possession": "🔑", "RERA No.": "✅", "Base Price": "💰",
 };
 
 const SECTIONS = [
